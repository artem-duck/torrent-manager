# Web UI
SECRET_KEY=change-me-please
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Data location inside container
DATA_DIR=/app/data

# Optional request timeout (seconds)
REQUEST_TIMEOUT_SECONDS=30

# Local timezone for logs and UI timestamps (IANA name)
APP_TIMEZONE=Europe/Moscow

# FlareSolverr settings (seconds)
FLARESOLVERR_TIMEOUT=90
FLARESOLVERR_RETRIES=2
FLARESOLVERR_STARTUP_TIMEOUT=90
